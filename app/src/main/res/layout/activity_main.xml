<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:text="Local Catalog AI" android:textSize="28sp" android:textStyle="bold"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="8dp" android:text="On-device catalog image prototype"/>
        <Button android:id="@+id/selectPhoto" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="20dp"
            android:text="Select product photo"/>
        <Button android:id="@+id/generateCatalog" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Generate catalog image" android:enabled="false"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="16dp" android:text="Original" android:textStyle="bold"/>
        <ImageView android:id="@+id/originalPreview" android:layout_width="match_parent"
            android:layout_height="280dp" android:scaleType="centerInside"
            android:contentDescription="Original product photo"/>
        <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginTop="12dp" android:text="Catalog preview" android:textStyle="bold"/>
        <ImageView android:id="@+id/catalogPreview" android:layout_width="match_parent"
            android:layout_height="280dp" android:scaleType="centerInside"
            android:contentDescription="Catalog image preview"/>
        <Button android:id="@+id/saveImage" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:layout_marginTop="8dp"
            android:text="Save image" android:enabled="false"/>
        <TextView android:id="@+id/status" android:layout_width="wrap_content"
            android:layout_height="wrap_content" android:layout_marginTop="12dp"
            android:text="Choose a product photo to begin."/>
    </LinearLayout>
</ScrollView>
