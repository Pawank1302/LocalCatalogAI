<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="24dp" android:gravity="center">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:text="Local Catalog AI" android:textSize="28sp" android:textStyle="bold"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:layout_marginTop="12dp" android:text="On-device catalog image prototype"/>
    <Button android:id="@+id/selectPhoto" android:layout_width="match_parent"
        android:layout_height="wrap_content" android:layout_marginTop="28dp"
        android:text="Select product photo"/>
    <ImageView android:id="@+id/preview" android:layout_width="match_parent"
        android:layout_height="360dp" android:layout_marginTop="16dp"
        android:scaleType="centerInside" android:contentDescription="Product preview"/>
    <TextView android:id="@+id/status" android:layout_width="wrap_content"
        android:layout_height="wrap_content" android:layout_marginTop="12dp"
        android:text="V1: choose a photo. Local AI processing comes next."/>
</LinearLayout>
